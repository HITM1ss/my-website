---
export interface Props {
	fallback: string;
	endpoint: string;
	cacheHours?: number;
	maxLength?: number;
	typewriter?: {
		enable?: boolean;
		speed?: number;
		deleteSpeed?: number;
		pauseTime?: number;
	};
}

const {
	fallback,
	endpoint,
	cacheHours = 24,
	maxLength = 88,
	typewriter,
} = Astro.props;
---

<span
	class="netease-comment-subtitle"
	data-netease-comment-subtitle
	data-endpoint={endpoint}
	data-fallback={fallback}
	data-cache-hours={cacheHours}
	data-max-length={maxLength}
	data-typewriter={typewriter?.enable === true ? "true" : "false"}
	data-typewriter-speed={typewriter?.speed ?? 100}
>{fallback}</span>

<script>
	type CachedComment = {
		content: string;
		expiresAt: number;
	};

	type SubtitleElement = HTMLElement & {
		__neteaseCommentTimer?: number;
	};

	const selector = "[data-netease-comment-subtitle]";
	const cachePrefix = "firefly:netease-comment:v3:";
	const requestTimeout = 8000;

	function readCache(cacheKey: string): string | undefined {
		try {
			const rawValue = localStorage.getItem(cacheKey);
			if (!rawValue) return;

			const cached = JSON.parse(rawValue) as Partial<CachedComment>;
			if (
				typeof cached.content !== "string" ||
				typeof cached.expiresAt !== "number" ||
				cached.expiresAt <= Date.now()
			) {
				localStorage.removeItem(cacheKey);
				return;
			}

			return cached.content;
		} catch {
			return;
		}
	}

	function writeCache(cacheKey: string, content: string, cacheHours: number) {
		try {
			const expiresAt = Date.now() + cacheHours * 60 * 60 * 1000;
			localStorage.setItem(cacheKey, JSON.stringify({ content, expiresAt }));
		} catch {
			// 在隐私模式或存储空间不足时，直接显示本次结果。
		}
	}

	function truncate(text: string, maxLength: number): string {
		const characters = Array.from(text.trim().replace(/\s+/g, " "));
		if (characters.length <= maxLength) return characters.join("");
		return `${characters.slice(0, maxLength).join("")}…`;
	}

	function renderSubtitle(element: SubtitleElement, text: string) {
		if (element.__neteaseCommentTimer) {
			window.clearTimeout(element.__neteaseCommentTimer);
		}

		if (element.dataset.typewriter !== "true") {
			element.textContent = text;
			return;
		}

		const characters = Array.from(text);
		const speed = Number.parseInt(element.dataset.typewriterSpeed || "100", 10);
		let index = 0;
		element.textContent = "";

		const typeNextCharacter = () => {
			index += 1;
			element.textContent = characters.slice(0, index).join("");
			if (index < characters.length) {
				element.__neteaseCommentTimer = window.setTimeout(
					typeNextCharacter,
					Number.isFinite(speed) && speed >= 0 ? speed : 100,
				);
			}
		};

		typeNextCharacter();
	}

	async function fetchComment(element: SubtitleElement) {
		const endpoint = element.dataset.endpoint;
		if (!endpoint) return;

		const cacheHours = Math.max(
			1,
			Number.parseFloat(element.dataset.cacheHours || "24") || 24,
		);
		const maxLength = Math.max(
			1,
			Math.floor(Number.parseFloat(element.dataset.maxLength || "88") || 88),
		);
		const cacheKey = `${cachePrefix}${endpoint}`;
		const cached = readCache(cacheKey);
		if (cached) {
			renderSubtitle(element, cached);
			return;
		}

		const fallback = element.dataset.fallback || element.textContent || "";
		renderSubtitle(element, fallback);

		const controller = new AbortController();
		const timeoutId = window.setTimeout(() => controller.abort(), requestTimeout);

		try {
			const response = await fetch(endpoint, {
				cache: "no-store",
				headers: { Accept: "application/json" },
				signal: controller.signal,
			});
			if (!response.ok) throw new Error(`Unexpected response: ${response.status}`);

			const payload = (await response.json()) as {
				content?: unknown;
				isFallback?: unknown;
			};
			if (typeof payload.content !== "string" || !payload.content.trim()) {
				throw new Error("Missing comment content");
			}

			const content = truncate(payload.content, maxLength);
			// 备用文案不缓存，密钥配置或构建更新后可立即获取最新静态热评。
			if (payload.isFallback === false) {
				writeCache(cacheKey, content, cacheHours);
			}
			renderSubtitle(element, content);
		} catch {
			// 静态副标题已在页面中渲染，接口不可用时无需额外提示。
		} finally {
			window.clearTimeout(timeoutId);
		}
	}

	function initNeteaseCommentSubtitles() {
		document.querySelectorAll<SubtitleElement>(selector).forEach((element) => {
			if (element.dataset.initialized === "true") return;
			element.dataset.initialized = "true";
			void fetchComment(element);
		});
	}

	const globalWindow = window as typeof window & {
		__fireflyNeteaseCommentSubtitleInitialized?: boolean;
	};

	if (!globalWindow.__fireflyNeteaseCommentSubtitleInitialized) {
		globalWindow.__fireflyNeteaseCommentSubtitleInitialized = true;
		document.addEventListener("swup:contentReplaced", initNeteaseCommentSubtitles);
		document.addEventListener("swup:content:replace", initNeteaseCommentSubtitles);
		document.addEventListener("swup:page:view", initNeteaseCommentSubtitles);
		globalWindow.swup?.hooks?.on("content:replace", initNeteaseCommentSubtitles);
		globalWindow.swup?.hooks?.on("page:view", initNeteaseCommentSubtitles);
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initNeteaseCommentSubtitles, {
			once: true,
		});
	} else {
		initNeteaseCommentSubtitles();
	}
</script>

<style>
	.netease-comment-subtitle[data-typewriter="true"]::after {
		content: "|";
		margin-left: 2px;
		animation: blink 1s infinite;
	}

	@keyframes blink {
		0%,
		50% {
			opacity: 1;
		}
		51%,
		100% {
			opacity: 0;
		}
	}
</style>
